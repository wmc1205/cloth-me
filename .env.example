# 이 파일은 "어떤 키가 필요한지" 이름만 적는 용도입니다. 실제 값은 .env.local 에만 넣고 절대 커밋하지 마세요.
# Vercel 배포 시에는 프로젝트 설정(Environment Variables)에 같은 이름으로 등록합니다.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (서버 전용) ---
ANTHROPIC_API_KEY=

# --- 날씨 (선택, 5단계에서 사용) ---
WEATHER_API_KEY=
